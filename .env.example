# Copy this file to .env and fill in real values. Never commit .env.

# Server
PORT=3000
NODE_ENV=development

# Postgres (used by Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/chatbot_platform?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# Auth
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Claude API (used from Week 2 onward, included here so it's ready)
ANTHROPIC_API_KEY="sk-ant-..."
